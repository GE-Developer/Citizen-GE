    "Project.Disclaimer.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citizen is an independent preparation platform.\n\nThe app is not an official resource and is not affiliated with, endorsed or sponsored by the Government of Georgia or any of its state bodies.\n\nAll materials are provided for informational purposes only, do not replace official sources and do not guarantee any exam result."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citizen დამოუკიდებელი მოსამზადებელი პლატფორმაა.\n\nაპლიკაცია არ არის ოფიციალური რესურსი, არ არის დაკავშირებული საქართველოს მთავრობასთან ან მის უწყებებთან და არ არის მათ მიერ დამტკიცებული ან დაფინანსებული.\n\nმასალები საინფორმაციო ხასიათისაა, არ ცვლის ოფიციალურ წყაროებს და არ იძლევა გამოცდის შედეგის გარანტიას."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citizen - независимая платформа для подготовки.\n\nПриложение не является официальным ресурсом, не связано с Правительством Грузии и его государственными органами, не одобрено и не спонсируется ими. \n\nМатериалы носят информационный характер, не заменяют официальные источники и не гарантируют результат экзамена."
          }
        }
      }
    },
