        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თქვენი პასუხები, სტატისტიკა და შენახული სიტყვები და კითხვები წაიშლება ყველა თქვენს მოწყობილობაზე. მოქმედების გაუქმება შეუძლებელია."
          }
        },
        "ru" : {
          "stringUnit" : {
