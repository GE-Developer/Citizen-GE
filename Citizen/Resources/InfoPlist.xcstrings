    "NSContactsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citizen saves a contact you choose to your address book. Your contacts are never read or uploaded."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citizen შეინახავს თქვენ მიერ არჩეულ კონტაქტს კონტაქტებში. თქვენს კონტაქტებს არასოდეს ვკითხულობთ და არსად ვტვირთავთ."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Citizen сохранит выбранный вами контакт в адресную книгу. Ваши контакты не читаются и никуда не отправляются."
          }
        }
      }
    }
  },
  "version" : "1.0"
